spring.application.name=api

server.port=4000

spring.datasource.url=jdbc:mysql://localhost:3306/drivesmart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=drivesmart_app
spring.datasource.password=changeme
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Generate your own, e.g.: openssl rand -hex 32
app.jwt.secret=changeme-use-a-long-random-secret
app.jwt.expiration-ms=604800000

app.cors.allowed-origin=http://localhost:5173
