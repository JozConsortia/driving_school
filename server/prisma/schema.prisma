generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  LEARNER
  INSTRUCTOR
  SCHOOL_ADMIN
  SYSTEM_ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())

  learner       Learner?
  instructor    Instructor?
  ownedSchool   DrivingSchool?
  reviews       Review[]
  notifications Notification[]
}

model DrivingSchool {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  owner       User     @relation(fields: [ownerId], references: [id])
  name        String
  description String?
  city        String
  address     String?
  phone       String?
  email       String?
  status      String   @default("PENDING") // PENDING, APPROVED, SUSPENDED, REJECTED
  createdAt   DateTime @default(now())

  instructors Instructor[]
  vehicles    Vehicle[]
  services    SchoolService[]
  bookings    Booking[]
  reviews     Review[]
}

model LicenceCategory {
  id   String @id @default(cuid())
  code String @unique // e.g. "Code 8", "Code 10"
  name String

  services SchoolService[]
  bookings Booking[]
}

model SchoolService {
  id                String          @id @default(cuid())
  schoolId          String
  school            DrivingSchool   @relation(fields: [schoolId], references: [id])
  licenceCategoryId String
  licenceCategory   LicenceCategory @relation(fields: [licenceCategoryId], references: [id])
  pricePerHour      Float

  @@unique([schoolId, licenceCategoryId])
}

model Instructor {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  schoolId String
  school   DrivingSchool @relation(fields: [schoolId], references: [id])
  bio      String?
  status   String @default("ACTIVE") // ACTIVE, SUSPENDED

  availabilities Availability[]
  bookings       Booking[]
  lessonRecords  LessonRecord[]
}

model Vehicle {
  id           String   @id @default(cuid())
  schoolId     String
  school       DrivingSchool @relation(fields: [schoolId], references: [id])
  make         String
  model        String
  year         Int?
  licencePlate String
  transmission String   @default("MANUAL") // MANUAL, AUTOMATIC
  status       String   @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED

  bookings Booking[]
}

model Availability {
  id           String     @id @default(cuid())
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  date         DateTime
  startTime    String // "09:00"
  endTime      String // "10:00"
  isBooked     Boolean    @default(false)

  @@index([instructorId, date])
}

model Learner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  bookings Booking[]
  reviews  Review[]
}

model Booking {
  id                String   @id @default(cuid())
  learnerId         String
  learner           Learner  @relation(fields: [learnerId], references: [id])
  instructorId      String
  instructor        Instructor @relation(fields: [instructorId], references: [id])
  schoolId          String
  school            DrivingSchool @relation(fields: [schoolId], references: [id])
  vehicleId         String?
  vehicle           Vehicle? @relation(fields: [vehicleId], references: [id])
  licenceCategoryId String
  licenceCategory   LicenceCategory @relation(fields: [licenceCategoryId], references: [id])
  date              DateTime
  startTime         String
  endTime           String
  status            String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, REJECTED
  createdAt         DateTime @default(now())

  lessonRecord LessonRecord?

  @@index([instructorId, date])
  @@index([learnerId, date])
}

model LessonRecord {
  id           String     @id @default(cuid())
  bookingId    String     @unique
  booking      Booking    @relation(fields: [bookingId], references: [id])
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  notes        String?
  progress     String?
  attendance   String     @default("PRESENT") // PRESENT, ABSENT
  completedAt  DateTime   @default(now())
}

model Review {
  id        String   @id @default(cuid())
  learnerId String
  learner   Learner  @relation(fields: [learnerId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  schoolId  String
  school    DrivingSchool @relation(fields: [schoolId], references: [id])
  rating    Int
  comment   String?
  status    String   @default("VISIBLE") // VISIBLE, REPORTED, REMOVED
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
